{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://senp.ai0/schemas/pose-output.schema.json",
  "title": "Senp.ai0 diagnostic pose output",
  "type": "object",
  "required": ["schema_version", "coordinates", "image", "frames"],
  "properties": {
    "schema_version": {"const": 1},
    "coordinates": {"enum": ["normalized", "pixels"]},
    "image": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    },
    "source": {"type": "object"},
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["timestamp_ms", "landmarks"],
        "properties": {
          "timestamp_ms": {"type": "integer", "minimum": 0},
          "landmarks": {
            "type": "array",
            "minItems": 33,
            "maxItems": 33,
            "items": {
              "type": "object",
              "required": ["index", "x", "y", "z", "visibility", "presence"],
              "properties": {
                "index": {"type": "integer", "minimum": 0, "maximum": 32},
                "x": {"type": "number"},
                "y": {"type": "number"},
                "z": {"type": "number"},
                "visibility": {"type": "number", "minimum": 0, "maximum": 1},
                "presence": {"type": "number", "minimum": 0, "maximum": 1}
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
