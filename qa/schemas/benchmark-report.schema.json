{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://senp.ai0/schemas/benchmark-report.schema.json",
  "title": "Senp.ai0 benchmark report",
  "type": "object",
  "required": ["schema_version", "suite", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string"},
    "suite": {"type": "string", "minLength": 1},
    "metadata": {"type": "object"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "repetitions", "median_ms", "p95_ms", "peak_rss_bytes"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "fps": {"type": "integer", "minimum": 0},
          "input_duration_ms": {"type": "integer", "minimum": 0},
          "repetitions": {"type": "integer", "minimum": 1},
          "median_ms": {"type": "number", "minimum": 0},
          "p95_ms": {"type": "number", "minimum": 0},
          "peak_rss_bytes": {"type": "integer", "minimum": 0},
          "raw": {"type": "object"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
