{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://senp.ai0/schemas/lane-artifact.schema.json",
  "title": "Senp.ai0 Wave 1 lane artifact envelope",
  "type": "object",
  "required": ["contract_version", "lane", "run_id", "created_at", "artifacts"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "lane": {"enum": ["kernel", "video_pose", "motion", "alignment", "qa"]},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string"},
    "git": {
      "type": "object",
      "properties": {
        "commit": {"type": "string"},
        "dirty": {"type": "boolean"}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "path", "sha256"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "schema": {"type": "string"},
          "scenario_id": {"type": "string"}
        }
      }
    }
  },
  "additionalProperties": true
}
