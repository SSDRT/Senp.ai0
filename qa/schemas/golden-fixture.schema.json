{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://senp.ai0/schemas/golden-fixture.schema.json",
  "title": "Senp.ai0 deterministic golden fixture",
  "type": "object",
  "required": ["contract_version", "scenario_id", "inputs", "expectations"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "scenario_id": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "inputs": {
      "type": "object",
      "required": ["reference", "candidate"],
      "properties": {
        "reference": {"$ref": "#/$defs/track"},
        "candidate": {"$ref": "#/$defs/track"}
      }
    },
    "expectations": {"type": "object"}
  },
  "$defs": {
    "track": {
      "type": "object",
      "required": ["time_unit", "samples"],
      "properties": {
        "time_unit": {"const": "ms"},
        "samples": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["timestamp_ms", "valid", "features"],
            "properties": {
              "timestamp_ms": {"type": "integer", "minimum": 0},
              "valid": {"type": "boolean"},
              "features": {"type": "object", "additionalProperties": {"type": "number"}}
            }
          }
        }
      }
    }
  }
}
